# Server
PORT=8000
HOST_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_SSL=false
# DB_SSL_CA=<base64-encoded-ca-cert>  # Set for production to enable cert verification

# JWT (use strong random secrets in production)
JWT_SECRET=your-jwt-secret-min-32-chars-long

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com

# Frontend
FRONTEND_URL=http://localhost:3000

# CORS (comma-separated origins for production, e.g. "https://app.com,https://admin.app.com")
# CORS_ORIGINS=https://app.com,https://admin.app.com

# Cookie settings
COOKIE_SECURE=false
# COOKIE_DOMAIN=.yourdomain.com

# Rate limiting uses in-memory store. For multi-instance production,
# integrate rate-limit-redis with your own Redis connection.

# Observability (optional)
LOG_LEVEL=info
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Timeouts
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000

# Account lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
